<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission to read SMS messages -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Permission to receive SMS messages -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Post notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Internet access for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Vibration for notifications -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only READ_SMS is required; owner name will be asked from the user at runtime -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Detail Activity for SMS processing -->
        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication"
            android:parentActivityName=".MainActivity" />

        <!-- FileProvider for secure file sharing (Android 7.0+) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- SMS Receiver for live SMS processing -->
        <receiver android:name=".SmsReceiver" android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>